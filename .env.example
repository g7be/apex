# Copy to .env and adjust. All values are optional; these are the defaults.

# HTTP + WebSocket port for the game server.
GAME_PORT=8787
# SQLite database for persistent player data (balances, leases, positions).
DB_PATH=server/data/game.db
# Region to serve (a directory in data/world/).
REGION=indianapolis-downtown
WORLD_DIR=data/world
# Virtual currency every new player starts with.
STARTING_BALANCE=25000
# Real-time length of one lease term ("one in-game month"), in hours.
LEASE_DURATION_HOURS=24
# Leases a player can hold at once.
MAX_LEASES_PER_PLAYER=8
# Radius in meters for the "Nearby" chat channel.
CHAT_RADIUS=150
# Players further away than this are not streamed to each other (meters).
INTEREST_RADIUS=1500
# Optional statewide data in data/world/<STATE_REGION> (see README).
STATE_REGION=indiana
